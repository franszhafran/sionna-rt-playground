# Environment variables for Sionna RT
# This file contains environment setup for LLVM backend

# If you have LLVM installed via Homebrew (for Apple Silicon):
# export DRJIT_LIBLLVM_PATH="/opt/homebrew/opt/llvm/lib/libLLVM.dylib"

# If you have LLVM installed via Homebrew (for Intel Mac):
# export DRJIT_LIBLLVM_PATH="/usr/local/opt/llvm/lib/libLLVM.dylib"

# To install LLVM on macOS:
# brew install --build-from-source llvm
# This may take 30-60 minutes to compile

# After installation, uncomment the appropriate line above
